<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Interoperability KPIs</title>
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0f172a; color: #94a3b8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 14px; }
    header { background: #1e3a5f; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #334155; }
    header h1 { color: #60a5fa; font-size: 18px; font-weight: 600; }
    .updated { font-size: 11px; color: #475569; }
    nav { background: #1e293b; padding: 0 24px; border-bottom: 1px solid #334155; display: flex; gap: 4px; }
    .tab-btn { background: none; border: none; color: #64748b; padding: 12px 18px; cursor: pointer; font-size: 13px; border-bottom: 2px solid transparent; transition: color 0.15s; }
    .tab-btn:hover { color: #94a3b8; }
    .tab-btn.active { color: #60a5fa; border-bottom-color: #60a5fa; }
    .tab-content { display: none; padding: 24px; }
    .tab-content.active { display: block; }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .kpi-card { background: #1e293b; border-radius: 8px; padding: 16px; border: 1px solid #334155; }
    .kpi-label { font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .kpi-value { font-size: 28px; font-weight: 700; line-height: 1; margin-bottom: 6px; }
    .kpi-delta { font-size: 12px; }
    .kpi-delta.up { color: #34d399; }
    .kpi-delta.down { color: #f87171; }
    .kpi-adoption { color: #34d399; }
    .kpi-customers { color: #60a5fa; }
    .kpi-executions { color: #f59e0b; }
    .kpi-ao { color: #a78bfa; }
    .section { background: #1e293b; border-radius: 8px; padding: 16px; border: 1px solid #334155; margin-bottom: 16px; }
    .section h3 { color: #cbd5e1; font-size: 13px; font-weight: 600; margin-bottom: 12px; }
    .chart-container { width: 100%; height: 320px; }
    .chart-container.tall { height: 420px; }
    .chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .chart-row.chart-row-3 { grid-template-columns: repeat(3, 1fr); }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { color: #64748b; text-align: left; padding: 8px 12px; border-bottom: 1px solid #334155; font-weight: 500; text-transform: uppercase; font-size: 10px; letter-spacing: 0.05em; }
    td { padding: 8px 12px; border-bottom: 1px solid #1e293b; color: #94a3b8; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #1e293b; }
    .callout { background: #1e3a5f; border: 1px solid #2563eb; border-radius: 6px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; }
    .callout-value { font-size: 22px; font-weight: 700; color: #f59e0b; }
    .callout-text { font-size: 12px; color: #94a3b8; }
    .warning-banner { background: #422006; border: 1px solid #b45309; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px; font-size: 12px; color: #fcd34d; line-height: 1.5; }
    .warning-banner strong { color: #fef3c7; }
    .exec-summary { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 16px; margin-bottom: 16px; font-size: 12.5px; line-height: 1.6; color: #cbd5e1; }
    .exec-summary h4 { color: #60a5fa; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
    .exec-summary p { margin-bottom: 10px; }
    .exec-summary dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; font-size: 12px; }
    .exec-summary dt { color: #94a3b8; font-weight: 600; white-space: nowrap; }
    .exec-summary dd { color: #64748b; }
    @media (max-width: 900px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } .chart-row { grid-template-columns: 1fr; } .chart-row.chart-row-3 { grid-template-columns: 1fr; } }
    .sql-block { margin-top: 10px; }
    .sql-toggle { background: #0f172a; color: #60a5fa; border: 1px solid #334155; border-radius: 6px; padding: 5px 10px; font-size: 11px; cursor: pointer; font-family: inherit; letter-spacing: 0.03em; }
    .sql-toggle:hover { border-color: #60a5fa; }
    .sql-panel { position: relative; margin-top: 8px; border: 1px solid #334155; border-radius: 6px; background: #0b1220; }
    .sql-copy { position: absolute; top: 8px; right: 8px; background: #1e293b; color: #94a3b8; border: 1px solid #334155; border-radius: 4px; padding: 3px 8px; font-size: 10px; cursor: pointer; font-family: inherit; text-transform: uppercase; letter-spacing: 0.05em; }
    .sql-copy:hover { color: #60a5fa; border-color: #60a5fa; }
    .sql-panel pre { margin: 0; padding: 12px 14px; overflow-x: auto; font-family: 'SF Mono', Menlo, Consolas, monospace; font-size: 11px; line-height: 1.5; color: #cbd5e1; white-space: pre; }
    .filter-bar { display: flex; gap: 20px; margin-bottom: 12px; }
    .filter-bar label { font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 8px; }
    .filter-bar select { background: #0f172a; color: #cbd5e1; border: 1px solid #334155; border-radius: 6px; padding: 5px 8px; font-size: 12px; font-family: inherit; cursor: pointer; }
    .filter-bar select:hover { border-color: #60a5fa; }
  </style>
</head>
<body>

{% macro sql_panel(key, domid=none) -%}
{% set did = domid or key -%}
  <div class="sql-block">
    <button class="sql-toggle" id="sqlbtn-{{ did }}" onclick="toggleSql('{{ did }}')">▸ SQL</button>
    <div class="sql-panel" id="sql-{{ did }}" style="display:none">
      <button class="sql-copy" onclick="copySql('{{ did }}')">Copy</button>
      <pre id="sqlcode-{{ did }}">{{ sql[key]|e }}</pre>
    </div>
  </div>
{%- endmacro %}

<header>
  <h1>📊 Data Interoperability KPIs</h1>
  <span class="updated">Last updated: {{ generated_at }} · Source: Snowflake CANONICAL</span>
</header>

<nav>
  <button class="tab-btn active" onclick="switchTab('overview')">Overview</button>
  <button class="tab-btn" onclick="switchTab('adoption')">Adoption</button>
  <button class="tab-btn" onclick="switchTab('usage')">Usage</button>
  <button class="tab-btn" onclick="switchTab('segments')">Segments</button>
  <button class="tab-btn" onclick="switchTab('datafabric')">Data Fabric</button>
  <button class="tab-btn" onclick="switchTab('targeting')">Targeting</button>
  <button class="tab-btn" onclick="switchTab('datainterop')">Data InterOperability</button>
  <button class="tab-btn" onclick="switchTab('connectorchanges')">Data InterOperability - UI Telemetry</button>
  <button class="tab-btn" onclick="switchTab('successmetrics')">Data InterOperability Success Metrics</button>
</nav>

<!-- OVERVIEW -->
<div id="tab-overview" class="tab-content active">
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">Adoption Rate</div>
      <div class="kpi-value kpi-adoption">{{ "%.2f"|format(kpis.adoption_pct.value) }}%</div>
      <div class="kpi-delta {{ kpis.adoption_pct.direction }}">
        {{ "▲" if kpis.adoption_pct.direction == "up" else "▼" }}
        {{ "%+.2f"|format(kpis.adoption_pct.delta) }}pp MoM
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Active Customers</div>
      <div class="kpi-value kpi-customers">{{ "{:,}".format(kpis.active_customers.value) }}</div>
      <div class="kpi-delta {{ kpis.active_customers.direction }}">
        {{ "▲" if kpis.active_customers.direction == "up" else "▼" }}
        {{ "%+d"|format(kpis.active_customers.delta) }} MoM
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Prod Executions (last full mo.)</div>
      <div class="kpi-value kpi-executions">{{ "{:,}".format(kpis.prod_executions.value) }}</div>
      <div class="kpi-delta {{ kpis.prod_executions.direction }}">
        {{ "▲" if kpis.prod_executions.direction == "up" else "▼" }}
        {{ "%+.1f"|format(kpis.prod_executions.delta) }}% MoM
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Prod AO Last Week</div>
      <div class="kpi-value kpi-ao">{{ "{:,.0f}".format(kpis.prod_ao_last_week.value / 1000) }}K</div>
      <div class="kpi-delta {{ kpis.prod_ao_last_week.direction }}">
        {{ "▲" if kpis.prod_ao_last_week.direction == "up" else "▼" }}
        {{ "%+.1f"|format(kpis.prod_ao_last_week.delta) }}% MoM
      </div>
    </div>
  </div>

  <div class="section">
    <h3>Adoption Trend (12 months)</h3>
    <div id="chart-overview-sparkline" class="chart-container"></div>
    {{ sql_panel('adoption_trend', 'adoption_overview') }}
  </div>
</div>

<!-- ADOPTION -->
<div id="tab-adoption" class="tab-content">
  <div class="chart-row">
    <div class="section">
      <h3>Monthly Adoption Trend</h3>
      <div id="chart-adoption-trend" class="chart-container tall"></div>
      {{ sql_panel('adoption_trend') }}
    </div>
    <div class="section">
      <h3>All-Time Population</h3>
      <div id="chart-population-donut" class="chart-container tall"></div>
      {{ sql_panel('population_donut') }}
    </div>
  </div>
  <div class="section">
    <h3>Monthly Detail</h3>
    <table>
      <thead>
        <tr><th>Month</th><th>Interop Customers</th><th>SKU Customers</th><th>Total</th><th>Adoption %</th></tr>
      </thead>
      <tbody>
        {% for row in tables.adoption_trend %}
        <tr>
          <td>{{ row.month }}</td>
          <td>{{ "{:,}".format(row.interop) }}</td>
          <td>{{ "{:,}".format(row.sku) }}</td>
          <td>{{ "{:,}".format(row.total) }}</td>
          <td>{{ "%.2f"|format(row.adoption_pct) }}%</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<!-- USAGE -->
<div id="tab-usage" class="tab-content">
  <div class="section">
    <h3>Connector Executions by Month (Prod / Dev / Nonprod)</h3>
    <div id="chart-executions-bar" class="chart-container tall"></div>
    {{ sql_panel('executions_bar') }}
  </div>
  <div class="section">
    <h3>AO Usage Trend — Last Week Value</h3>
    <div id="chart-ao-usage-line" class="chart-container"></div>
    {{ sql_panel('ao_usage_line') }}
  </div>
</div>

<!-- SEGMENTS -->
<div id="tab-segments" class="tab-content">
  <div class="chart-row">
    <div class="section">
      <h3>By Product Family</h3>
      <div id="chart-product-family-bar" class="chart-container tall"></div>
      {{ sql_panel('product_family_bar') }}
    </div>
    <div class="section">
      <h3>By Architecture Type</h3>
      <div id="chart-arch-type-bar" class="chart-container tall"></div>
      {{ sql_panel('arch_type_bar') }}
    </div>
  </div>
  <div class="section">
    <div class="callout">
      <div class="callout-value">{{ sku_gap }}</div>
      <div class="callout-text">
        <strong style="color:#f59e0b">SKU Gap</strong><br>
        Companies actively using Data Interoperability without a formal SKU entitlement.
      </div>
    </div>
  </div>
  <div class="section">
    <h3>Adoption by Deployment Option (ODC agents)</h3>
    <div id="chart-deployment-option" class="chart-container"></div>
    {{ sql_panel('deployment_option_bar') }}
  </div>
</div>

<!-- DATA FABRIC -->
<div id="tab-datafabric" class="tab-content">
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">DF Connectors (last full mo.)</div>
      <div class="kpi-value kpi-customers">{{ "{:,}".format(kpis.df_connectors.value) }}</div>
      <div class="kpi-delta {{ kpis.df_connectors.direction }}">
        {{ "▲" if kpis.df_connectors.direction == "up" else "▼" }} {{ "%+.1f"|format(kpis.df_connectors.delta) }}% MoM
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">DF Tenants (last full mo.)</div>
      <div class="kpi-value kpi-adoption">{{ "{:,}".format(kpis.df_tenants.value) }}</div>
      <div class="kpi-delta {{ kpis.df_tenants.direction }}">
        {{ "▲" if kpis.df_tenants.direction == "up" else "▼" }} {{ "%+.1f"|format(kpis.df_tenants.delta) }}% MoM
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Active Providers</div>
      <div class="kpi-value kpi-executions">{{ kpis.df_providers.value }}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Trialing Connectors (last full mo.)</div>
      <div class="kpi-value kpi-customers">{{ "{:,}".format(kpis.df_trialing_connectors.value) }}</div>
      <div class="kpi-delta {{ kpis.df_trialing_connectors.direction }}">
        {{ "▲" if kpis.df_trialing_connectors.direction == "up" else "▼" }} {{ "%+.1f"|format(kpis.df_trialing_connectors.delta) }}% MoM
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Trialing Tenants (last full mo.)</div>
      <div class="kpi-value kpi-adoption">{{ "{:,}".format(kpis.df_trialing_tenants.value) }}</div>
      <div class="kpi-delta {{ kpis.df_trialing_tenants.direction }}">
        {{ "▲" if kpis.df_trialing_tenants.direction == "up" else "▼" }} {{ "%+.1f"|format(kpis.df_trialing_tenants.delta) }}% MoM
      </div>
    </div>
  </div>
  <div class="chart-row">
    <div class="section"><h3>Connector Usage Trend (12 mo.)</h3><div id="chart-df-trend" class="chart-container tall"></div>{{ sql_panel('data_fabric_trend') }}</div>
    <div class="section"><h3>By Provider (last full mo.)</h3><div id="chart-df-providers" class="chart-container tall"></div>{{ sql_panel('data_fabric_providers') }}</div>
  </div>
</div>

<!-- TARGETING -->
<div id="tab-targeting" class="tab-content">
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">ARR at Risk (interop, no SKU)</div>
      <div class="kpi-value kpi-ao">€{{ "{:,.0f}".format(kpis.arr_at_risk.value) }}</div>
      <div class="kpi-delta">{{ sku_gap_count }} customers</div>
    </div>
  </div>
  <div class="section">
    <h3>SKU Gap — Interop customers without SKU (top 20 by ARR)</h3>
    <table>
      <thead><tr><th>Company</th><th>Segment</th><th>Deployment</th><th>ARR (EUR)</th></tr></thead>
      <tbody>
        {% for r in tables.sku_gap_targeting %}
        <tr><td>{{ r.company }}</td><td>{{ r.segment }}</td><td>{{ r.deployment }}</td><td>{{ "{:,.0f}".format(r.arr_eur) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="section">
    <h3>Active Production Infra Not Reporting Telemetry (top 20)</h3>
    <table>
      <thead><tr><th>Company</th><th>Architecture</th><th>Deployment</th><th>Activation Code</th></tr></thead>
      <tbody>
        {% for r in tables.infra_no_telemetry %}
        <tr><td>{{ r.company }}</td><td>{{ r.arch }}</td><td>{{ r.deployment }}</td><td>{{ r.activation_code }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div id="tab-datainterop" class="tab-content">
  <div class="chart-row chart-row-3">
    <div class="section"><h3>Customers with Data Fabric Connections for O11 — Development</h3><div id="chart-interop-dev" class="chart-container tall"></div>{{ sql_panel('interop_dev') }}</div>
    <div class="section"><h3>Customers with Data Fabric Connections for O11 — Non-Production</h3><div id="chart-interop-nonprod" class="chart-container tall"></div>{{ sql_panel('interop_nonprod') }}</div>
    <div class="section"><h3>Customers with Data Fabric Connections for O11 — Production</h3><div id="chart-interop-prod" class="chart-container tall"></div>{{ sql_panel('interop_prod') }}</div>
  </div>
  <div class="chart-row chart-row-3">
    <div class="section"><h3>Customers with Apps that use Data Connections for O11 — Development</h3><div id="chart-interop-apps-dev" class="chart-container tall"></div>{{ sql_panel('interop_apps_dev') }}</div>
    <div class="section"><h3>Customers with Apps that use Data Connections for O11 — Non-Production</h3><div id="chart-interop-apps-nonprod" class="chart-container tall"></div>{{ sql_panel('interop_apps_nonprod') }}</div>
    <div class="section"><h3>Customers with Apps that use Data Connections for O11 — Production</h3><div id="chart-interop-apps-prod" class="chart-container tall"></div>{{ sql_panel('interop_apps_prod') }}</div>
  </div>
  <div class="section">
    <h3>Connector Removal Events by Company (all-time)</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      Every day-over-day decrease in a tenant/environment's O11 connector count, rolled up per
      company — partial removals included, not just full disconnects (see the "Customers Who Fully
      Removed Their O11 Connector Infrastructure" table in the Data InterOperability - UI Telemetry
      tab for customers who dropped O11 entirely). Peak = max simultaneous connectors the company
      ever had; Today = current live connectors (series silent >14 days count as removed). Excludes
      internal OutSystems tenants.
    </p>
    <table>
      <thead><tr><th>Company</th><th>Removal Events</th><th>Connectors Removed</th><th>Peak Connectors</th><th>Connectors Today</th></tr></thead>
      <tbody>
        {% for r in tables.removal_events_by_company %}
        <tr>
          <td>{{ r.company }}</td>
          <td>{{ r.removal_events }}</td>
          <td>{{ r.connectors_removed }}</td>
          <td>{{ r.peak_connectors }}</td>
          <td>{{ r.connectors_today }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {{ sql_panel('removal_events_by_company') }}
  </div>
  <div class="section">
    <h3>Customers with Multiple O11 Infrastructures Using Data Fabric</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      Customers running more than one active O11 enterprise infrastructure (activation code) that
      also have at least one live O11 Data Fabric connection. O11 Infras = distinct active
      activation codes; DF Providers = distinct Data Fabric providers with telemetry; DF
      Connectors = current connector count (latest reading per tenant/env/provider, summed).
    </p>
    <table>
      <thead><tr><th>Company</th><th>O11 Infras</th><th>DF Providers</th><th>Current DF Connectors</th></tr></thead>
      <tbody>
        {% for r in tables.multi_o11_with_df %}
        <tr>
          <td>{{ r.company }}</td>
          <td>{{ r.o11_infras }}</td>
          <td>{{ r.df_providers }}</td>
          <td>{{ r.df_connectors }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {{ sql_panel('multi_o11_with_df') }}
  </div>
</div>

<div id="tab-connectorchanges" class="tab-content">
  <div class="chart-row">
    <div class="section"><h3>Connector Changes per Month (add/remove + reconfigure)</h3><div id="chart-connector-changes-monthly" class="chart-container tall"></div>{{ sql_panel('connector_changes_monthly') }}</div>
    <div class="section"><h3>Connector Changes by Day of Week (12 mo., UTC)</h3><div id="chart-connector-changes-dow" class="chart-container tall"></div>{{ sql_panel('connector_changes_dow') }}</div>
  </div>
  <div class="section">
    <h3>Connector Changes by Cloud Region — ga+ea rings</h3>
    <div class="filter-bar">
      <label>Month <select id="region-month" onchange="renderRegionChart()"></select></label>
    </div>
    <div id="chart-connector-changes-by-region" class="chart-container tall"></div>
    {{ sql_panel('connector_changes_by_region') }}
  </div>
  <div class="section">
    <h3>Connector Add/Removes per Tenant by Region × Ring — Avg (bars) &amp; Median (line), 12 mo.</h3>
    <div id="chart-changes-per-tenant" class="chart-container tall"></div>
    {{ sql_panel('changes_per_tenant_combo') }}
  </div>
  <div class="section">
    <h3>Avg Connector Changes per Tenant — Region × Weekday (12 mo., UTC)</h3>
    <div class="filter-bar">
      <label>Time range
        <select id="heatmap-window" onchange="renderHeatmap()">
          <option value="all">All time (12 mo.)</option>
          <option value="6m">Last 6 months</option>
          <option value="3m">Last 3 months</option>
          <option value="1m">Last month</option>
        </select>
      </label>
      <label>Ring
        <select id="heatmap-ring" onchange="renderHeatmap()">
          <option value="all">All (ga+ea)</option>
          <option value="ga">ga</option>
          <option value="ea">ea</option>
        </select>
      </label>
      <label>Change type
        <select id="heatmap-type" onchange="renderHeatmap()">
          <option value="both">Add/Remove + Reconfigure</option>
          <option value="add_remove">Add/Remove</option>
          <option value="reconfigure">Reconfigure</option>
        </select>
      </label>
    </div>
    <div id="chart-change-heatmap" class="chart-container tall"></div>
    {{ sql_panel('change_heatmap') }}
  </div>
  <div class="section">
    <h3>Recommended Connector Freeze Window by Region (weekday-level, all-time)</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      Weekday with the lowest avg connector changes per tenant. Time-of-day isn't captured
      (daily UTC snapshots, ~1-day lag), so this is weekday-level — weekends are quietest everywhere.
      Values in parentheses are avg changes/tenant. Regions with ≥3 tenants.
    </p>
    <table>
      <thead><tr><th>Region</th><th>Tenants</th><th>Best freeze day</th><th>Quietest weekday (Mon–Fri)</th><th>Busiest — avoid</th></tr></thead>
      <tbody>
        {% for r in tables.freeze_windows %}
        <tr>
          <td>{{ r.region }}</td>
          <td>{{ r.tenants }}</td>
          <td>{{ r.quietest_day }} ({{ r.quietest_avg }})</td>
          <td>{{ r.quietest_biz_day }} ({{ r.quietest_biz_avg }})</td>
          <td>{{ r.busiest_day }} ({{ r.busiest_avg }})</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="section">
    <h3>Customers Who Fully Removed Their O11 Connector Infrastructure</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      EXTERNALCONNECTIONCOUNT is a daily gauge that reports even with no change, so a >14-day
      silence after a nonzero reading means the connector was actually removed. Aggregated to the
      tenant level — a customer counts only if it no longer reports <em>any</em> O11 connector in
      <em>any</em> environment (a single quiet dev env while the main connector is live does not
      count). Restricted to tenants still active/current with recent platform usage, to exclude
      customers who churned entirely rather than just dropping the O11 connector.
    </p>
    <table>
      <thead><tr><th>Company</th><th>Tenant</th><th>O11 Envs</th><th>Peak Connectors</th><th>Last Known Count</th><th>Telemetry Last Seen</th><th>Days Silent</th></tr></thead>
      <tbody>
        {% for r in tables.o11_infra_removals %}
        <tr>
          <td>{{ r.company }}</td>
          <td>{{ r.tenant_id }}</td>
          <td>{{ r.n_envs }}</td>
          <td>{{ r.peak_count }}</td>
          <td>{{ r.last_count }}</td>
          <td>{{ r.last_seen }}</td>
          <td>{{ r.days_silent }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {{ sql_panel('o11_infra_removals') }}
  </div>
  <div class="section">
    <h3>Connector Removal Events — Multi-O11-Infra Customers (all-time)</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      The "Connector Removal Events by Company" view in the Data InterOperability tab, restricted
      to the multi-O11-infra population (q21). {% if not tables.removal_events_multi_o11 %}<strong>No rows:</strong> every
      company with connector-removal events has only a single O11 infrastructure — removal activity
      is concentrated entirely among single-infra customers.{% endif %}
    </p>
    <table>
      <thead><tr><th>Company</th><th>O11 Infras</th><th>Removal Events</th><th>Connectors Removed</th><th>Peak Connectors</th><th>Connectors Today</th></tr></thead>
      <tbody>
        {% for r in tables.removal_events_multi_o11 %}
        <tr>
          <td>{{ r.company }}</td>
          <td>{{ r.o11_infras }}</td>
          <td>{{ r.removal_events }}</td>
          <td>{{ r.connectors_removed }}</td>
          <td>{{ r.peak_connectors }}</td>
          <td>{{ r.connectors_today }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {{ sql_panel('removal_events_multi_o11') }}
  </div>
  <div class="section">
    <h3>Fully Removed O11 Connector Infrastructure — Multi-O11-Infra Customers</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      The "Customers Who Fully Removed Their O11 Connector Infrastructure" view above, restricted
      to the multi-O11-infra population (q21) — i.e. customers who removed their O11 Data Fabric
      connection despite running several O11 infrastructures.
    </p>
    <table>
      <thead><tr><th>Company</th><th>Tenant</th><th>O11 Infras</th><th>O11 Envs</th><th>Peak Connectors</th><th>Last Known Count</th><th>Telemetry Last Seen</th><th>Days Silent</th></tr></thead>
      <tbody>
        {% for r in tables.o11_infra_removals_multi_o11 %}
        <tr>
          <td>{{ r.company }}</td>
          <td>{{ r.tenant_id }}</td>
          <td>{{ r.o11_infras }}</td>
          <td>{{ r.n_envs }}</td>
          <td>{{ r.peak_count }}</td>
          <td>{{ r.last_count }}</td>
          <td>{{ r.last_seen }}</td>
          <td>{{ r.days_silent }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {{ sql_panel('o11_infra_removals_multi_o11') }}
  </div>
</div>

<div id="tab-successmetrics" class="tab-content">
  <div class="exec-summary">
    <h4>Executive Summary</h4>
    <p><strong>Task 1 (multi-pipeline, one infra):</strong> {{ success_metrics.task1_summary }}</p>
    <p><strong>Task 2 (multi-infra, distinct activation codes):</strong> {{ success_metrics.task2_summary }}</p>
    <h4>Definitions</h4>
    <dl>
      <dt>O11/ODC customer</dt><dd>a customer whose deployment option is O11/ODC that month (point-in-time, from the customer policy population).</dd>
      <dt>Multi-Pipeline TAM (Task 1)</dt><dd>an O11/ODC customer whose O11 infrastructure has 2+ parallel live production environments -- a proxy for "2+ pipelines" (see warning banner).</dd>
      <dt>Multi-Infra TAM (Task 2)</dt><dd>an O11/ODC customer holding 2+ distinct O11 activation codes -- i.e. 2+ separate enterprise infrastructures, as of that month.</dd>
      <dt>Reach</dt><dd>of TAM, customers with at least one live O11 Data Fabric connection, in any environment/infrastructure -- baseline connectivity only.</dd>
      <dt>Validated use case</dt><dd>of Reach -- Task 1: connected to 2+ distinct non-development O11 environments; Task 2: 2+ distinct O11 infrastructures (LifeTime URLs) linked to their ODC tenant(s) at once.</dd>
      <dt>Depth</dt><dd>average # of entities imported per Data Fabric connection, split Dev / Non-Prod / Prod, among validated customers.</dd>
    </dl>
  </div>

  <h3 style="color:#cbd5e1;font-size:14px;margin-bottom:10px">Task 1 — Multiple Pipelines within One O11 Infrastructure</h3>
  <div class="warning-banner">
    <strong>⚠ Pipeline count is inferred, not measured.</strong> The O11 provisioning schema has no
    pipeline/path identifier, so "2+ pipelines" is proxied as "2+ live Production environments" in
    one infrastructure (see q25/q26 for the full rationale and coverage caveats). A consequence:
    the <strong>Validated</strong> stage below only confirms a customer connected 2+ distinct
    non-development O11 environments -- it does <strong>not</strong> confirm those environments sit
    on different pipelines (e.g. QA1+PRD1 on the same pipeline would still count). Also, the infra
    shape used is a <strong>current snapshot</strong> (no history), so this trend applies today's
    shape retroactively to each month's cohort -- movement reflects cohort churn, not historical
    pipeline changes.
  </div>
  <div class="chart-row chart-row-3">
    <div class="section"><h3>(a) TAM — Multi-Pipeline Customers</h3><div id="chart-t1a-tam" class="chart-container tall"></div>{{ sql_panel('t1a_tam') }}</div>
    <div class="section"><h3>(b) Reach — Baseline O11 Data Fabric Adoption</h3><div id="chart-t1b-reach" class="chart-container tall"></div>{{ sql_panel('t1b_reach') }}</div>
    <div class="section"><h3>(c) Validated — 2+ Non-Dev Environments Connected</h3><div id="chart-t1c-validated" class="chart-container tall"></div>{{ sql_panel('t1c_validated') }}</div>
  </div>
  <div class="section">
    <h3>(d) Depth/Breadth — Avg Entities per Connection (Dev/Non-Prod/Prod)</h3>
    <div id="chart-t1d-depth" class="chart-container tall"></div>
    {{ sql_panel('t1d_depth') }}
  </div>

  <h3 style="color:#cbd5e1;font-size:14px;margin:24px 0 10px">Task 2 — Multiple O11 Infrastructures (Distinct Activation Codes)</h3>
  <div class="chart-row">
    <div class="section"><h3>(a) TAM — Multi-Infra Customers</h3><div id="chart-t2a-tam" class="chart-container tall"></div>{{ sql_panel('t2a_tam') }}</div>
    <div class="section"><h3>(b) Reach — Baseline O11 Data Fabric Adoption</h3><div id="chart-t2b-reach" class="chart-container tall"></div>{{ sql_panel('t2b_reach') }}</div>
  </div>
  <div class="section">
    <h3>(c) Validated — # O11 Infras per Reach Customer — Signal: O11 Infra Configuration</h3>
    <div class="warning-banner">
      <strong>⚠ Data only from 2026-08-27, no backfill.</strong> This signal is the O11 Bridge
      Service's o11InfrastructureConfiguration event (ODC_METRIC.O11INFRASTRUCTURECONFIGURATION),
      first emitted on 2026-08-27. ODC↔O11 infrastructure links created before then appear only
      once they are next edited, so most Reach customers read as "Unresolved" for now, and earlier
      months are left out rather than estimated.
    </div>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      Of the Reach cohort, split by how many distinct O11 infrastructures the customer has linked
      to its ODC tenant(s) at month end -- counted as distinct LifeTime URLs, which are unique per
      O11 infrastructure, from the latest created/updated/deleted event per link (see q32).
      "Validated" = 2+. Linking an O11 infrastructure is the prerequisite step before any O11 Data
      Fabric connector can be set up on it.
    </p>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      <strong>What "Unresolved" means:</strong> already-connected (Reach) customers with no live
      O11 infrastructure configuration event yet -- almost always because their link predates the
      event going live. They are kept separate rather than defaulted into the 1-infra bucket, and
      should shrink as links are edited or if the owning team backfills the history.
    </p>
    <div id="chart-t2c-validated" class="chart-container tall"></div>
    {{ sql_panel('t2c_validated') }}
  </div>
  <div class="section">
    <h3>(c) Validated — # O11 Infras per Reach Customer — Signal: LT Unification Handshake (new)</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:10px">
      Same breakdown, sourced instead from TELEMETRYANALYTICS.METRICS.LIFETIME_UNIFICATION -- O11
      Lifetime's new per-handshake telemetry (DOMAIN_ODCTENANTID + ENV_ACTIVATION_CODE), a direct
      handshake-level signal of actual traffic, complementing the configured links above. <strong>Expect this to read
      as almost entirely "Unresolved" today:</strong> as of this report, this telemetry stream has
      only ~8 rows total, all from the last few days ("Handshake_v1", a v1 event type), and none of
      its tenant IDs yet resolve to a real customer in CANONICAL -- likely early rollout/test
      traffic. This is the better long-term signal once it matures; kept here as a running check
      rather than backfilled or estimated.
    </p>
    <div id="chart-t2c-validated-unification" class="chart-container tall"></div>
    {{ sql_panel('t2c_validated_unification') }}
  </div>
  <div class="chart-row">
    <div class="section">
      <h3>(d) Depth/Breadth — Avg Entities per Connection — Signal: O11 Infra Configuration</h3>
      <p style="font-size:11px;color:#64748b;margin-bottom:10px">
        Averaged per connection across all of a customer's O11 infrastructures combined, not broken
        out per infrastructure (see q33). Currently empty: zero customers are in the 2+-infra
        (validated) bucket above yet, so there is no connection population to measure.
      </p>
      <div id="chart-t2d-depth" class="chart-container tall"></div>
      {{ sql_panel('t2d_depth') }}
    </div>
    <div class="section">
      <h3>(d) Depth/Breadth — Avg Entities per Connection — Signal: LT Unification Handshake (new)</h3>
      <p style="font-size:11px;color:#64748b;margin-bottom:10px">
        Same depth calculation, scoped to the LT Unification-validated cohort above (see q35).
        Empty today for the same reason: no real customer has validated via this signal yet.
      </p>
      <div id="chart-t2d-depth-unification" class="chart-container tall"></div>
      {{ sql_panel('t2d_depth_unification') }}
    </div>
  </div>
</div>


<script>
  var charts = {
    adoption_trend:    {{ charts.adoption_trend | tojson }},
    population_donut:  {{ charts.population_donut | tojson }},
    executions_bar:    {{ charts.executions_bar | tojson }},
    ao_usage_line:     {{ charts.ao_usage_line | tojson }},
    product_family_bar:{{ charts.product_family_bar | tojson }},
    arch_type_bar:     {{ charts.arch_type_bar | tojson }},
    data_fabric_trend:     {{ charts.data_fabric_trend | tojson }},
    data_fabric_providers: {{ charts.data_fabric_providers | tojson }},
    deployment_option_bar: {{ charts.deployment_option_bar | tojson }},
    interop_dev:  {{ charts.interop_dev | tojson }},
    interop_nonprod: {{ charts.interop_nonprod | tojson }},
    interop_prod: {{ charts.interop_prod | tojson }},
    interop_apps_dev:  {{ charts.interop_apps_dev | tojson }},
    interop_apps_nonprod: {{ charts.interop_apps_nonprod | tojson }},
    interop_apps_prod: {{ charts.interop_apps_prod | tojson }},
    connector_changes_monthly: {{ charts.connector_changes_monthly | tojson }},
    connector_changes_dow:     {{ charts.connector_changes_dow | tojson }},
    connector_changes_by_region: {{ charts.connector_changes_by_region | tojson }},
    changes_per_tenant_combo: {{ charts.changes_per_tenant_combo | tojson }},
    change_heatmap: {{ charts.change_heatmap | tojson }},
    t1a_tam:       {{ charts.t1a_tam | tojson }},
    t1b_reach:     {{ charts.t1b_reach | tojson }},
    t1c_validated: {{ charts.t1c_validated | tojson }},
    t1d_depth:     {{ charts.t1d_depth | tojson }},
    t2a_tam:       {{ charts.t2a_tam | tojson }},
    t2b_reach:     {{ charts.t2b_reach | tojson }},
    t2c_validated: {{ charts.t2c_validated | tojson }},
    t2d_depth:     {{ charts.t2d_depth | tojson }},
    t2c_validated_unification: {{ charts.t2c_validated_unification | tojson }},
    t2d_depth_unification:     {{ charts.t2d_depth_unification | tojson }}
  };

  var cfg = {responsive: true, displayModeBar: false};

  Plotly.newPlot('chart-overview-sparkline',  charts.adoption_trend.data,     charts.adoption_trend.layout,     cfg);
  Plotly.newPlot('chart-adoption-trend',      charts.adoption_trend.data,     charts.adoption_trend.layout,     cfg);
  Plotly.newPlot('chart-population-donut',    charts.population_donut.data,   charts.population_donut.layout,   cfg);
  Plotly.newPlot('chart-executions-bar',      charts.executions_bar.data,     charts.executions_bar.layout,     cfg);
  Plotly.newPlot('chart-ao-usage-line',       charts.ao_usage_line.data,      charts.ao_usage_line.layout,      cfg);
  Plotly.newPlot('chart-product-family-bar',  charts.product_family_bar.data, charts.product_family_bar.layout, cfg);
  Plotly.newPlot('chart-arch-type-bar',       charts.arch_type_bar.data,      charts.arch_type_bar.layout,      cfg);
  Plotly.newPlot('chart-df-trend',           charts.data_fabric_trend.data,     charts.data_fabric_trend.layout,     cfg);
  Plotly.newPlot('chart-df-providers',       charts.data_fabric_providers.data, charts.data_fabric_providers.layout, cfg);
  Plotly.newPlot('chart-deployment-option',  charts.deployment_option_bar.data, charts.deployment_option_bar.layout, cfg);
  Plotly.newPlot('chart-interop-dev',   charts.interop_dev.data,   charts.interop_dev.layout,   cfg);
  Plotly.newPlot('chart-interop-nonprod', charts.interop_nonprod.data, charts.interop_nonprod.layout, cfg);
  Plotly.newPlot('chart-interop-prod',  charts.interop_prod.data,  charts.interop_prod.layout,  cfg);
  Plotly.newPlot('chart-interop-apps-dev',  charts.interop_apps_dev.data,  charts.interop_apps_dev.layout,  cfg);
  Plotly.newPlot('chart-interop-apps-nonprod', charts.interop_apps_nonprod.data, charts.interop_apps_nonprod.layout, cfg);
  Plotly.newPlot('chart-interop-apps-prod', charts.interop_apps_prod.data, charts.interop_apps_prod.layout, cfg);
  Plotly.newPlot('chart-connector-changes-monthly', charts.connector_changes_monthly.data, charts.connector_changes_monthly.layout, cfg);
  Plotly.newPlot('chart-connector-changes-dow',     charts.connector_changes_dow.data,     charts.connector_changes_dow.layout,     cfg);
  Plotly.newPlot('chart-changes-per-tenant', charts.changes_per_tenant_combo.data, charts.changes_per_tenant_combo.layout, cfg);
  Plotly.newPlot('chart-t1a-tam',       charts.t1a_tam.data,       charts.t1a_tam.layout,       cfg);
  Plotly.newPlot('chart-t1b-reach',     charts.t1b_reach.data,     charts.t1b_reach.layout,     cfg);
  Plotly.newPlot('chart-t1c-validated', charts.t1c_validated.data, charts.t1c_validated.layout, cfg);
  Plotly.newPlot('chart-t1d-depth',     charts.t1d_depth.data,     charts.t1d_depth.layout,     cfg);
  Plotly.newPlot('chart-t2a-tam',       charts.t2a_tam.data,       charts.t2a_tam.layout,       cfg);
  Plotly.newPlot('chart-t2b-reach',     charts.t2b_reach.data,     charts.t2b_reach.layout,     cfg);
  Plotly.newPlot('chart-t2c-validated', charts.t2c_validated.data, charts.t2c_validated.layout, cfg);
  Plotly.newPlot('chart-t2d-depth',     charts.t2d_depth.data,     charts.t2d_depth.layout,     cfg);
  Plotly.newPlot('chart-t2c-validated-unification', charts.t2c_validated_unification.data, charts.t2c_validated_unification.layout, cfg);
  Plotly.newPlot('chart-t2d-depth-unification',     charts.t2d_depth_unification.data,     charts.t2d_depth_unification.layout,     cfg);

  var hmData = charts.change_heatmap;
  function renderHeatmap() {
    var w = document.getElementById('heatmap-window').value;
    var ring = document.getElementById('heatmap-ring').value;
    var t = document.getElementById('heatmap-type').value;
    var v = hmData.variants[w + '|' + ring + '|' + t] || hmData.variants[hmData.default];
    Plotly.react('chart-change-heatmap', v.data, v.layout, cfg);
  }
  renderHeatmap();

  var rcData = charts.connector_changes_by_region;
  function renderRegionChart() {
    var m = document.getElementById('region-month').value;
    var v = rcData.variants[m] || rcData.variants[rcData.default];
    Plotly.react('chart-connector-changes-by-region', v.data, v.layout, cfg);
  }
  (function initRegionChart() {
    var sel = document.getElementById('region-month');
    ['all'].concat(rcData.months).forEach(function (m) {
      var o = document.createElement('option');
      o.value = m; o.textContent = (m === 'all' ? 'All months' : m);
      sel.appendChild(o);
    });
    renderRegionChart();
  })();

  function toggleSql(key) {
    var panel = document.getElementById('sql-' + key);
    var btn = document.getElementById('sqlbtn-' + key);
    var open = panel.style.display === 'none';
    panel.style.display = open ? 'block' : 'none';
    btn.textContent = (open ? '▾' : '▸') + ' SQL';
  }

  function copySql(key) {
    var code = document.getElementById('sqlcode-' + key).textContent;
    navigator.clipboard.writeText(code);
  }

  function switchTab(name) {
    document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.remove('active'); });
    document.querySelectorAll('.tab-btn').forEach(function(el) { el.classList.remove('active'); });
    document.getElementById('tab-' + name).classList.add('active');
    document.querySelector('[onclick="switchTab(\'' + name + '\')"]').classList.add('active');
    window.dispatchEvent(new Event('resize'));
  }
</script>
</body>
</html>
